generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ParentSchool {
  id        String   @id @default(uuid())
  name      String
  city      String?
  country   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  sections  School[]
}

model School {
  id                 String              @id @default(uuid())
  name               String
  type               SchoolType
  email              String              @unique
  phone              String?
  address            String?
  website            String?
  logo               String?
  // Defaults to TEACHERS, so existing schools keep behaving exactly as they did.
  marksEntryMode     MarksEntryMode      @default(TEACHERS)
  // Whether registration is collected and reported APART from the class fee. It does not
  // change what a student owes — that is always feeAmount + registrationFee — only whether
  // the two are kept as separate totals and separate receipts, or added into one figure.
  // False keeps every existing school reading exactly as it did.
  registrationSeparate Boolean            @default(false)
  marksEntryChanges  MarksEntryModeChange[]
  // Official stamp/seal image. Prints on OFFICIAL copies only, via a `stamp` section
  // the admin places on the report card or transcript. Separate from `logo`: the logo
  // is the letterhead mark on every copy, the stamp is what makes a copy official.
  stamp              String?
  subdomain          String              @unique
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  coverImage         String?
  parentSchoolId     String?
  language           String              @default("EN")
  coverImages        String[]            @default([])
  acronym            String?
  batch              Int?
  authorizationNumber String?
  // How many minutes the school counts as one teaching period ("school hour"), e.g. 50.
  // Set on the Set Up Periods screen and required before timetable/attendance features
  // work. Distinct from a real 60-min clock hour: a course's required *hours* are counted
  // in real 60-min hours, but a teacher's *attendance* (periods missed) is counted in
  // these periods — missing a 100-min class with a 50-min period is 2 periods missed.
  // Nullable so existing schools are prompted to set it rather than silently defaulted.
  // Day and Evening are separate sittings with their own bell schedule (see
  // TimetablePeriod.programme), so each gets its own period length — an evening course
  // runs its own curriculum with its own evaluations, and lumping its missed-period count
  // in with the day's would count time against the wrong programme entirely.
  dayPeriodMinutes     Int?
  eveningPeriodMinutes Int?
  // Minutes after a period STARTS before the teacher counts as having missed it. Once this
  // is up, an absence logged against that period is final: nobody, admin included, can
  // mark them present again. Judged per period, so on a double period a late arrival loses
  // only the first one. Nullable, and null keeps the older behaviour (a period is only
  // final once it has ENDED), so a live school is unaffected until an admin sets it.
  absenceGraceMinutes Int?
  // Official-header letterhead text (left/right blocks in the "Official"
  // report-card header style), set once here so it stays consistent no
  // matter how many report-card templates/layouts render it. One EN and one
  // FR variant per side; the header auto-picks the one matching `language`.
  officialLeftTextEn  String?
  officialLeftTextFr  String?
  officialRightTextEn String?
  officialRightTextFr String?
  classLevels        ClassLevel[]
  departments        Department[]
  classListTemplate  ClassListTemplate?
  excelTemplates     ExcelTemplate[]
  feePayments              FeePayment[]
  hndRegistrationPayments  HndRegistrationPayment[]
  gradingScale             GradingScale?
  competencyScale          CompetencyScale?
  promotionScale           PromotionScale?
  reportCards        ReportCard[]
  reportCardTemplate ReportCardTemplate?
  parentSchool       ParentSchool?       @relation(fields: [parentSchoolId], references: [id])
  students           Student[]
  subjects           Subject[]
  subjectExclusions           SubjectExclusion[]
  terms              Term[]
  users              User[]
  timetableSlots     TimetableSlot[]
  timetablePeriods   TimetablePeriod[]
  teacherAbsences    TeacherAbsence[]
  notifications      Notification[]
  pastTermMarksGrants PastTermMarksGrant[]
  holidays                 SchoolHoliday[]
  guardians                Guardian[]
  guardianInvites          GuardianInvite[]
  guardianAccessRequests   GuardianAccessRequest[]
}

model GradingScale {
  id        String   @id @default(uuid())
  schoolId  String   @unique
  ranges    Json     @default("[]")
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id])
}

// The developmental ratings a COMPETENCY class is assessed on (see utils/competency.ts).
// Deliberately its own table rather than another column on GradingScale: that row is read
// and AUTO-MIGRATED on every load (getGradingScale rewrites a stale 0-100 scale in place),
// and entangling nursery ratings with that rewrite is how a correct scale gets wiped.
//
// `levels` is an ordered array, highest attainment first:
//   { id, labelEn, labelFr, short, color }
// Empty array = this school has never customised them, so the API serves the built-in
// defaults. Labels carry both languages because a custom label cannot go through t(),
// which only knows the three built-in English strings.
model CompetencyScale {
  id        String   @id @default(uuid())
  schoolId  String   @unique
  levels    Json     @default("[]")
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id])
}

// The real pass/fail decision an admin can influence: below the school's true pass mark
// (10/20 for non-university, fixed; the school's own GradingScale classification "Pass"
// band for university) but at or above trialMinimum, a student still advances but the
// report-cards list shows trialLabel instead of passLabel — different schools word this
// differently ("promoted on trial", "conditional pass", etc). trialMinimum null = no trial
// band at all, same as the old repeatThreshold being unset: endAcademicYear writes no
// decisions.
model PromotionScale {
  id           String   @id @default(uuid())
  schoolId     String   @unique
  trialMinimum Float?
  passLabel    String   @default("Pass")
  trialLabel   String   @default("This student was promoted on trial")
  repeatLabel  String   @default("Repeat")
  updatedAt    DateTime @updatedAt
  school       School   @relation(fields: [schoolId], references: [id])
}

model ReportCardTemplate {
  id        String   @id @default(uuid())
  schoolId  String   @unique
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id])
}

model ClassListTemplate {
  id        String   @id @default(uuid())
  schoolId  String   @unique
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id])
}

model Department {
  id        String       @id @default(uuid())
  schoolId  String
  name      String
  order     Int          @default(0)
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  school    School       @relation(fields: [schoolId], references: [id])
  classes   ClassLevel[]

  @@unique([schoolId, name])
}

model ClassLevel {
  id           String   @id @default(uuid())
  schoolId     String
  name         String
  abbreviation String?
  hasStream    Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  feeAmount            Int      @default(0)
  // Enrolment registration, charged once per academic year on top of feeAmount. Nothing to
  // do with hndRegistrationFee below, which is the GOVERNMENT EXAM registration (FSLC / GCE
  // / HND) a final-year class pays to an exam board — different money, different ledger.
  //
  // Defaults to 0 so every existing school is unchanged: a school whose feeAmount already
  // covers registration simply leaves this alone.
  registrationFee      Int      @default(0)
  maxScore             Int      @default(20)
  // Primary only: the Test component's ceiling out of `maxScore` (Exam ceiling is
  // maxScore - testMaxScore, derived rather than stored — same relationship as university's
  // hardcoded 30/70 CA/Exam split, just school-configurable here). Ignored by
  // secondary/university, which keep the sequence/CA-Exam split they already have.
  testMaxScore         Int      @default(30)
  hndRegistrationFee   Int?
  departmentId         String?
  // Day or Evening sitting. Existing classes are all DAY, which keeps every school that
  // has no evening programme exactly as it was.
  programme            Programme @default(DAY)
  // How this class is assessed. NUMERIC is everything that came before: Test+Exam (primary)
  // or sequences (secondary) producing a score, an average and a class position.
  //
  // COMPETENCY is for nursery/pre-primary, which is not marked out of anything: each subject
  // gets a developmental rating (Attained / Developing / Not Yet Attained) and the card
  // carries no average, no total and no position — ranking three-year-olds is the thing this
  // mode exists to avoid. Stored per CLASS rather than inferred from the class NAME (the way
  // isRegistrationClass detects Class Six for FSLC) because class names are free text: a
  // French section names these Maternelle, a school may name them anything at all, and a
  // school that wants Class 1 assessed this way can simply say so. Admin-set on the Classes
  // page, primary-only in the UI though nothing here is type-specific.
  gradingMode          GradingMode @default(NUMERIC)
  // A mark ceiling (`maxScore`, and primary's `testMaxScore`) is FROZEN for the rest of an
  // academic year once this class has published cards in a term of that year which has since
  // closed: the marks already handed out were scored against it, and a `Subject` keeps its
  // OWN copy of the ceilings from when it was created, so a mid-year change does not
  // re-scale anything — it leaves one class holding two different scales with nothing on
  // screen saying so. Judged per class, so a class created mid-year is never blocked.
  //
  // This is that freeze's only escape hatch: a superadmin grants it, and the next successful
  // ceiling change consumes it (set back to null). Null = locked. A timestamp rather than a
  // boolean so the grant says when it was made.
  scaleUnlockedAt      DateTime?
  department           Department? @relation(fields: [departmentId], references: [id])
  school               School   @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, name])
}

model User {
  id                String           @id @default(uuid())
  schoolId          String?
  name              String
  // Nullable: a person with no email account (common for teachers/admins) logs in with
  // `username` instead — see below. Postgres treats every NULL as distinct under a unique
  // index, so any number of no-email accounts coexist without colliding on this column.
  email             String?          @unique
  // Alternative login identifier for someone with no email. 8+ chars, no whitespace,
  // validated in utils/passwordValidation.ts. Exactly one of email/username is required at
  // creation (enforced in each creation path, not at the DB level — see createTeacher,
  // buildAdminAccount). Once a username-only account adds a real email (self-service, see
  // updateMyEmail), BOTH remain valid login identifiers — the username is never cleared.
  username          String?          @unique
  password          String
  role              UserRole
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  masterClassLevel  String?
  preferredLanguage String           @default("EN")
  // Departments (secondary) / programmes (university) this teacher is explicitly
  // placed in — independent of which subjects they're assigned, so a newly added
  // teacher shows under a department immediately rather than only after their first
  // subject assignment. Plain strings, not a relation: universities have no real
  // Department row at all (see department.controller.ts), department there is only
  // a name embedded in class names, so a uniform string list works for both types.
  // A teacher can be in more than one at once.
  departments       String[]         @default([])
  // Self-service "forgot password" flow — cloud only (the offline SQLite build has no
  // email delivery, so its route is stubbed out entirely; see
  // scripts/offline-build/stubs/passwordReset.routes.stub.ts). Deliberately NOT mirrored
  // to prisma/sqlite/schema.prisma: no offline code path ever reads or writes these, so
  // there is nothing to keep in sync there. Stores a SHA-256 hash of the emailed token,
  // never the raw token itself.
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?
  // University semester a teacher was created under, while they have zero course
  // assignments — lets getTeachers show a brand-new teacher only in the semester
  // tab they were added under (not every tab) even before they're assigned a real
  // course. Ignored the moment they have ANY TeacherSubject; assigning them a
  // course in a different semester IS how an admin "transfers" them there — no
  // separate transfer action. Not university-specific in the schema (harmless
  // null elsewhere), mirrored to prisma/sqlite/schema.prisma since this bug and
  // fix apply to both builds equally.
  createdForTerm      String?
  // Set the first time a teacher actually completes the set-password flow (see
  // passwordReset.controller.ts resetPassword). Null means an online-invited
  // teacher has never set a password yet — used to show a "Pending Setup" badge
  // in getTeachers (shared code, both builds). Offline-created teachers get this
  // stamped immediately at creation, since the admin hands them a working
  // password directly there — always non-null offline, so pendingSetup is
  // always false there. Mirrored to prisma/sqlite/schema.prisma for that reason.
  passwordSetAt       DateTime?
  reportCards      ReportCard[]
  teacherSubjects  TeacherSubject[]
  timetableSlots   TimetableSlot[]
  absences         TeacherAbsence[] @relation("TeacherAbsences")
  absencesRecorded TeacherAbsence[] @relation("AbsencesRecorded")
  notifications    Notification[]
  pastTermMarksGrantsGiven PastTermMarksGrant[]
  guardianOf       Guardian[]
  school           School?          @relation(fields: [schoolId], references: [id])

  // email/username are already unique-indexed, so login is fine; this is for the
  // staff-list and class-master lookups, which filter by school and role.
  @@index([schoolId, role])
}

model Student {
  id            String        @id @default(uuid())
  schoolId      String
  name          String
  studentId     String
  classLevel    String
  guardianName  String?
  guardianPhone String?
  guardianEmail String?
  isActive            Boolean       @default(true)
  directLevel2Entry   Boolean       @default(false)
  isRepeatingLevel    Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  gender              String?
  // Birth details. Optional everywhere: a student registered without them simply prints
  // a blank row. Stored as "YYYY-MM-DD" TEXT rather than a DateTime on purpose — a birth
  // date is a calendar date with no time or zone, and round-tripping it through a
  // timestamp shifts it by a day for anyone west of UTC.
  dateOfBirth         String?
  placeOfBirth        String?
  status              StudentStatus @default(ACTIVE)
  // Uploaded file URL, same "/uploads/<file>" shape as School.logo/stamp. Absent = the
  // report card's identity box prints an empty labelled photo frame instead of an image.
  photo                    String?
  feePayments              FeePayment[]
  hndRegistrationPayments  HndRegistrationPayment[]
  reportCards              ReportCard[]
  school                   School        @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, studentId])
  subjectExclusions   SubjectExclusion[]
  guardians           Guardian[]
  guardianInvites     GuardianInvite[]
  guardianAccessRequests GuardianAccessRequest[]

  // @@unique([schoolId, studentId]) already covers "this school's students" as a
  // leftmost prefix; this covers the class roster reads, which are the common case.
  @@index([schoolId, classLevel])
}

model FeePayment {
  id         String   @id @default(uuid())
  schoolId   String
  studentId  String
  session    String
  amount     Int
  // What this money was for. Every row written before this column existed is tuition, which
  // is what the default backfills — there was nothing else it could have been.
  kind       FeeKind  @default(TUITION)
  paidOn     DateTime
  note       String?
  recordedBy String?
  createdAt  DateTime @default(now())
  school     School   @relation(fields: [schoolId], references: [id])
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, session])
  // The fees overview reads a whole school's ledger for one session at a time.
  @@index([schoolId, session])
}

model HndRegistrationPayment {
  id         String   @id @default(uuid())
  schoolId   String
  studentId  String
  session    String
  amount     Int
  paidOn     DateTime
  note       String?
  // Government exam registration number (FSLC/GCE/HND), once the school or exam body has
  // assigned one. Nullable on purpose — a school registering a student before the number
  // exists must not be blocked from recording the payment.
  examNumber String?
  recordedBy String?
  createdAt  DateTime @default(now())
  school     School   @relation(fields: [schoolId], references: [id])
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, session])
}

model Subject {
  id              String           @id @default(uuid())
  schoolId        String
  name            String
  code            String?
  classLevel      String
  createdAt       DateTime         @default(now())
  maxScore        Int              @default(20)
  // Primary only — see ClassLevel.testMaxScore. Inherited from the class at creation time,
  // same as maxScore.
  testMaxScore    Int              @default(30)
  coefficient     Int              @default(1)
  compulsory      Boolean          @default(true)
  credit          Int?
  term            String?
  // Target teaching hours for this subject/course row — per semester for university
  // (the row is already semester-scoped via `term`), per academic year for primary/
  // secondary (the row spans all three terms). Null means no target set: excluded
  // from the teaching-hours coverage report rather than treated as a 0-hour target.
  requiredHours   Int?
  reportEntries   ReportEntry[]
  school          School           @relation(fields: [schoolId], references: [id])
  teacherSubjects TeacherSubject[]
  timetableSlots  TimetableSlot[]
  pastTermGrants  PastTermMarksGrant[]
  exclusions      SubjectExclusion[]
  privateSlots    TimetableSlot[]    @relation("PrivateSlotCourse")

  // Subject had no index at all; { schoolId, classLevel } is how nearly every
  // marks and report card screen loads a class's subject list.
  @@index([schoolId, classLevel])
}

// A teacher may only edit marks for the CURRENTLY active term/semester — once it's no
// longer current, saveEntries refuses any real change from them regardless of publish
// status (a locked grid is a suggestion; this is what actually decides). This is the
// explicit, admin-granted exception for one (subject, term) pair: e.g. a teacher asks
// (outside the app) to fix a mistake found after the term closed, and the admin flips
// this on for just that course. Deliberately not scoped to one teacher — a course can
// have more than one — and not per-student: unlocking is a whole-class decision.
model PastTermMarksGrant {
  id          String   @id @default(uuid())
  schoolId    String
  subjectId   String
  termId      String
  createdAt   DateTime @default(now())
  grantedById String
  school      School   @relation(fields: [schoolId], references: [id])
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term        Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  grantedBy   User     @relation(fields: [grantedById], references: [id])

  @@unique([subjectId, termId])
  @@index([schoolId, termId])
}

// A teacher's own weekly schedule — one row per period, owned directly by the
// teacher (not derived through class/subject assignment). Deliberately no
// session/year scoping field: like ClassLevel/Subject, slots persist across
// academic sessions rather than resetting each year. Two kinds of slot:
//  - A school period: subjectId is set, which implies the class (subject.classLevel)
//    — admin can only pick from subjects this teacher is actually assigned to
//    (validated in saveTimetable), so it can't drift from real assignments.
//  - A private/personal slot (extra tutoring, etc.): subjectId is null, label is
//    free text. Not tied to any school class — this is why the slot belongs to
//    the teacher directly rather than being derived via a class's subjects, and
//    why it can extend beyond normal school hours.
model TimetableSlot {
  id           String    @id @default(uuid())
  schoolId     String
  teacherId    String
  dayOfWeek    String    // 'MONDAY'..'SUNDAY' — for a one-off slot, the weekday specificDate falls on
  startTime    String    // "08:00", 24h zero-padded — sortable as plain strings
  endTime      String    // "08:55"
  subjectId    String?   // set for a school period; null for a private/personal slot
  subject      Subject?  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  label        String?   // free text, used when subjectId is null (e.g. "Private tutoring")
  room         String?
  // "YYYY-MM-DD" — set only for a one-off private/extra slot that doesn't repeat every
  // week (e.g. a single Saturday tutoring session). null means the slot recurs weekly on
  // dayOfWeek, same as the original behavior.
  specificDate String?
  // Set when this slot has been superseded by a newer save of the same teacher's
  // timetable. Archived rows are never deleted (so TeacherAbsence rows already logged
  // against them keep working, and the admin can browse "previous timetable" history) but
  // are excluded from every live query — hours/coverage math only ever looks at the
  // current (archivedAt: null) timetable, never a mix of old and new. All slots archived
  // by the same save share the exact same timestamp, which is how they're grouped into
  // one "version" for the history view.
  // ── How long this slot runs (private/extra classes) ──────────────────────────
  // Three shapes, and only one of them can apply at a time:
  //   specificDate set          a single day, happens exactly once
  //   startsOn/endsOn set       recurs weekly on dayOfWeek, but only between those dates
  //   all three null            recurs weekly for the whole term/session (the original
  //                             behaviour, and what every school-period slot uses)
  // Dates are "YYYY-MM-DD" text for the same reason Student.dateOfBirth is: a DateTime
  // shifts a day across timezones, and these are calendar days, not instants.
  startsOn     String?
  endsOn       String?
  // A private class may be tied to a course, so the hours it delivers land on that
  // course's coverage instead of floating free. Deliberately NOT `subjectId`: that field
  // is what distinguishes a school period from a private slot everywhere in the codebase
  // (absence reporting, the builder's grid, coverage's own query), so reusing it would
  // silently turn every linked private class into a timetabled school period.
  privateSubjectId String?
  // SetNull, not Cascade: deleting a course must unlink the private class, never
  // delete it. The class still happened; it just stops counting toward that course.
  privateSubject   Subject? @relation("PrivateSlotCourse", fields: [privateSubjectId], references: [id], onDelete: SetNull)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  school       School    @relation(fields: [schoolId], references: [id])
  teacher      User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  absences     TeacherAbsence[]

  @@index([schoolId, teacherId])
  @@index([schoolId, teacherId, archivedAt])
}

// A teacher missing one scheduled period. One row per missed period — a "whole day
// absent" report is simply one of these per slot the teacher has that weekday, not a
// distinct kind of record, which keeps the teaching-hours math (see
// apps/api/src/utils/teachingHours.ts) a single sum over this table with no branching.
// `date` is "YYYY-MM-DD" plain text, same reasoning as Student.dateOfBirth: a calendar
// date has no timezone and must not round-trip through one. `recordedById` can differ
// from `teacherId` — an admin can log an absence on a teacher's behalf.
model TeacherAbsence {
  id              String   @id @default(uuid())
  schoolId        String
  teacherId       String
  timetableSlotId String
  date            String
  // Which period WITHIN the slot this row is, 0-based — a double period books two rows,
  // so a teacher who turns up late loses only the period they actually missed rather than
  // the whole block. null means a legacy row written before absences became per-period: it
  // still stands for the WHOLE slot and is counted with slotPeriods, and is never given
  // per-period siblings (see createAbsence), so counts can't double up. Both shapes are
  // read correctly and indefinitely; no backfill is required.
  periodIndex     Int?
  recordedById    String
  createdAt       DateTime @default(now())
  // True once an admin has viewed this record in the per-teacher absence list — from
  // then on it's a locked historical record (nobody, admin included, can delete it). Set
  // one view AFTER the admin actually looked at it (see getTeacherAbsences), not the same
  // view — so an admin still has their current visit's window to delete it if they want
  // to mark the teacher present instead ("just in case"), and only a later visit locks it.
  seenByAdmin     Boolean  @default(false)
  school          School         @relation(fields: [schoolId], references: [id])
  teacher         User           @relation("TeacherAbsences", fields: [teacherId], references: [id], onDelete: Cascade)
  slot            TimetableSlot  @relation(fields: [timetableSlotId], references: [id], onDelete: Cascade)
  recordedBy      User           @relation("AbsencesRecorded", fields: [recordedById], references: [id])

  @@unique([teacherId, timetableSlotId, date, periodIndex])
  @@index([schoolId, teacherId])
}

// In-app notification for a specific user (e.g. an admin, when a teacher reports an
// absence). Deliberately no push/email delivery here — this is the in-app inbox only;
// `type` is a free-form tag ("TEACHER_ABSENCE") for any future filtering, not an enum,
// since the set of notification kinds will likely grow.
model Notification {
  id          String    @id @default(uuid())
  schoolId    String
  recipientId String
  type        String
  title       String
  body        String
  // Where tapping this notification should take the recipient, captured when it is
  // created rather than looked up later: a retraction's absence row is already deleted
  // by the time anyone reads the notification, so nothing else could resolve it.
  // Shape depends on `type` and is documented where it's built (absenceNotificationLink
  // in teacherAbsence.controller.ts). Null on older rows and on any kind with nowhere
  // to go, which both clients treat as "not tappable".
  data        Json?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  school      School    @relation(fields: [schoolId], references: [id])
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
}

// One school-wide bell schedule (Period 1, Break, Period 2, ...), defined once
// by the admin. School-period slots on a teacher's timetable pick their time
// from here rather than free text, so the whole school shares one consistent
// schedule and two teachers can be reliably checked for a class-period clash.
// No `order` field — periods are always sorted by startTime, so admins never
// have to manually reorder rows after adding one out of sequence.
model TimetablePeriod {
  id        String  @id @default(uuid())
  schoolId  String
  startTime String
  endTime   String
  isBreak   Boolean @default(false)
  // Which sitting this period belongs to. Day and Evening are two fully independent bell
  // schedules (own periods, own breaks, own period length) rather than one shared list, so
  // there is no "whole school" option any more — every row picks one. Defaults to DAY,
  // which is a no-op for every school type except university (the only one with an
  // Evening sitting today).
  programme Programme @default(DAY)
  school    School  @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

model TeacherSubject {
  id        String   @id @default(uuid())
  userId    String
  subjectId String
  createdAt DateTime @default(now())
  // When this teacher actually took the course, and when they gave it up. Hours are only
  // counted inside this window, so a mid-term handover splits the course's hours between
  // the two teachers at the exact date the admin recorded.
  //
  // endedAt null = they still hold it. An ENDED row is deliberately kept rather than deleted:
  // it is the only record that the previous teacher ever taught it, and deleting it would
  // erase the hours they are owed.
  startedAt DateTime @default(now())
  endedAt   DateTime?
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // NOT unique on (userId, subjectId) any more: a teacher can hold a course, hand it over,
  // and take it back later, which is two legitimate rows. "Only one ACTIVE assignment per
  // teacher+course" is enforced in code instead (see assignSubjects), because a partial
  // unique index on endedAt IS NULL cannot be expressed in the Prisma schema and would show
  // as permanent drift.
  @@index([userId, subjectId])
  @@index([subjectId, endedAt])
}

// A school closure — public holiday, mid-term break, anything that cancels teaching. Stored
// as a NAMED RANGE rather than one row per day, because schools close for stretches and a
// row per day would be tedious to enter and easy to get half-wrong.
//
// Ranges are INCLUSIVE of both ends and may overlap each other; the hours maths merges them
// before subtracting, so an overlap can never remove the same day twice. Any scheduled period
// falling inside one is not counted as taught, and an absence reported for such a period stops
// subtracting too — nobody missed a class that never happened.
model SchoolHoliday {
  id        String   @id @default(uuid())
  schoolId  String
  name      String
  // Which sitting is closed. NULL = the whole school, which is what every existing holiday
  // means and stays the default. Set it only when one sitting runs through a closure the
  // other observes. Evening currently exists for universities only, so this is a no-op
  // everywhere else.
  programme Programme?
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, startDate])
}

model Term {
  id          String       @id @default(uuid())
  schoolId    String
  name        String
  session     String
  startDate   DateTime
  endDate     DateTime
  isCurrent       Boolean      @default(false)
  printingEnabled Boolean      @default(true)
  createdAt       DateTime     @default(now())
  reportCards     ReportCard[]
  school          School       @relation(fields: [schoolId], references: [id])
  pastTermMarksGrants PastTermMarksGrant[]

  // { schoolId, isCurrent } is the single hottest filter in the codebase (11 call
  // sites) and ran as a full scan of every term of every school on each request.
  @@index([schoolId, isCurrent])
  @@index([schoolId, session])
}

model ReportCard {
  id                   String        @id @default(uuid())
  studentId            String
  schoolId             String
  termId               String
  createdById          String
  status               ReportStatus  @default(DRAFT)
  totalScore           Float?
  average              Float?
  position             Int?
  remarks              String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  marksEditGrantedTo   String?
  remarksEditGrantedTo String?
  remarksFr            String?
  remarksAiEn          String?
  remarksAiFr          String?
  remarksSource        String?
  decision             String?
  createdBy            User          @relation(fields: [createdById], references: [id])
  school               School        @relation(fields: [schoolId], references: [id])
  student              Student       @relation(fields: [studentId], references: [id])
  term                 Term          @relation(fields: [termId], references: [id])
  entries              ReportEntry[]

  // @@unique([studentId, termId]) already indexes studentId (leftmost prefix), so
  // these cover the two lookups it cannot: a school's cards, and a term's cards.
  @@unique([studentId, termId])
  @@index([schoolId, termId])
  @@index([termId])
}

model ReportEntry {
  id           String     @id @default(uuid())
  reportCardId String
  subjectId    String
  score        Float?
  grade        String?
  remarks      String?
  seq1Score    Float?
  seq2Score    Float?
  resitScore   Float?     // university only: exam mark re-obtained after resitting a failed course; seq2Score is kept as the original attempt
  reportCard   ReportCard @relation(fields: [reportCardId], references: [id])
  subject      Subject    @relation(fields: [subjectId], references: [id])

  // The largest table in the database and it had no index but the primary key.
  // Postgres does not index foreign keys automatically, so every "marks for this
  // card" and "marks for this subject" read scanned the whole table.
  @@index([reportCardId])
  @@index([subjectId])
}

model ExcelTemplate {
  id          String   @id @default(uuid())
  schoolId    String
  name        String
  fileData    Bytes
  classLevels String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  school      School   @relation(fields: [schoolId], references: [id])
}

enum SchoolType {
  PRIMARY
  SECONDARY
  UNIVERSITY
}

enum UserRole {
  SUPERADMIN
  SCHOOL_ADMIN
  VICE_PRINCIPAL
  CLASS_TEACHER
  SUBJECT_TEACHER
  STUDENT
  PARENT
  CLASS_MASTER
}

enum ReportStatus {
  DRAFT
  PUBLISHED
}

enum StudentStatus {
  ACTIVE
  DISABLED
  DISMISSED
}

/**
 * Who records marks at a school.
 *
 * TEACHERS   - the default and how every school worked before this existed.
 * ADMIN_ONLY - only SCHOOL_ADMIN/VICE_PRINCIPAL may save marks. Some universities keep
 *              marks out of teachers' hands entirely to remove the opportunity to cheat.
 *              Teachers still SEE the grid, read-only, so they can check their subject.
 *
 * An enum rather than a boolean: the obvious next mode is "teachers keep CA, admin owns
 * the exam", which a boolean could not grow into.
 */
enum MarksEntryMode {
  TEACHERS
  ADMIN_ONLY
}

/// Which sitting of the school a class belongs to. A university commonly runs the same
/// programme twice with the same lecturers but different students (Level 1 Morning and
/// Level 1 Evening), and the two sittings need not offer the same levels at all — an
/// evening-only Level 3 is normal. Each sitting is its own ClassLevel, so students, marks,
/// positions and fees are already separate; this field only records which sitting a class
/// belongs to, so the app can group and filter by it instead of parsing the class name.
/// A secondary evening programme with a genuinely different curriculum is NOT this: that
/// is a separate School under the same ParentSchool.
enum Programme {
  DAY
  EVENING
}

/// How a class is assessed — see ClassLevel.gradingMode.
enum GradingMode {
  NUMERIC
  COMPETENCY
}

/**
 * Every switch of who records marks, kept forever.
 *
 * A log, NOT a "changedBy/changedAt" pair on School: switching to TEACHERS and back would
 * overwrite itself and leave only the innocent-looking final state, hiding exactly the
 * window this exists to reveal. Two flips must leave two rows.
 *
 * This does not PREVENT a switch, and cannot: an admin can already enter and change any
 * mark directly. What it removes is the ability to do it quietly.
 *
 * `changedByName` is a snapshot, not a join: an audit record must still read the same
 * after the user is renamed or deleted.
 */
model MarksEntryModeChange {
  id            String         @id @default(uuid())
  schoolId      String
  mode          MarksEntryMode
  changedById   String?
  changedByName String
  changedAt     DateTime       @default(now())
  /// The semester this switch happened in, so the "twice per semester" cap counts rows
  /// rather than doing date arithmetic. Null when no semester was running: between
  /// academic years there is nothing to count against, and switching is unrestricted.
  termId        String?
  /// A switch made BY the provider (superadmin) on the school's behalf. Never counts
  /// against the school's two, because it IS the permission that lifts the cap.
  byProvider    Boolean        @default(false)
  school        School         @relation(fields: [schoolId], references: [id])

  @@index([schoolId, changedAt])
  @@index([schoolId, termId])
}

/// A student who does NOT take an optional course, even though the course belongs to their
/// class. University departments are otherwise a fixed course list — everyone sits
/// everything — so this is the ONLY way a course can be absent from one student's report
/// card without being absent from their classmates'.
///
/// Deliberately an EXCLUSION list rather than an enrolment list: the default has to stay
/// "everyone in the department takes this", so a course that is merely marked optional
/// behaves exactly as before until somebody is actually ticked off it. An enrolment list
/// would have silently emptied every optional course the day it shipped.
///
/// Only meaningful where `Subject.compulsory` is false; a compulsory course ignores these.
model SubjectExclusion {
  id        String   @id @default(uuid())
  schoolId  String
  subjectId String
  studentId String
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([subjectId, studentId])
  @@index([schoolId, subjectId])
}

/**
 * Links a parent's login to one child. A join table rather than a column on either side:
 * one parent commonly has several children, and a child can have two parents holding
 * separate logins.
 *
 * `schoolId` is the school the CHILD attends. The parent's own User row deliberately has
 * schoolId = null (like SUPERADMIN), because a parent may have children in more than one
 * School at once — a primary and a secondary under the same ParentSchool are two separate
 * School rows, which is the common case here, not an edge case. Every parent-facing query
 * therefore resolves access through these rows and never through the token's schoolId.
 */
model Guardian {
  id        String   @id @default(uuid())
  schoolId  String
  userId    String
  studentId String
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // One link per parent/child pair; claiming the same child twice is a no-op, not a duplicate.
  @@unique([userId, studentId])
  // "Which children does this parent have" is the query behind every parent screen.
  @@index([userId])
  // Used when deleting a school, to find parent users that belong to no school themselves.
  @@index([schoolId])
}

/**
 * A single-use invitation letting a parent claim their account. Issued by an admin against
 * one student, delivered to the guardian's phone over WhatsApp (a wa.me deep link opened
 * from the admin's own phone, so no messaging gateway is involved) or handed over printed.
 *
 * Only the SHA-256 hash of the token is stored, never the token itself — the same treatment
 * User.resetTokenHash gets, and for the same reason: a leaked database should not hand
 * anyone a working key to a child's records.
 */
model GuardianInvite {
  id        String    @id @default(uuid())
  schoolId  String
  studentId String
  tokenHash String    @unique
  // The contact this invite was issued against, as it stood at that moment. Kept so a later
  // edit to the student's record cannot silently redirect an invite already in someone's
  // hand. Exactly one of the two is set, and it becomes the parent's login identifier: an
  // invite delivered over WhatsApp or on paper is keyed to the phone, one emailed from the
  // public sign-up form is keyed to the address it was sent to.
  phone     String?
  email     String?
  expiresAt DateTime
  claimedAt DateTime?
  claimedBy String?
  createdBy String
  createdAt DateTime  @default(now())
  school    School    @relation(fields: [schoolId], references: [id])
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // "Does this student have a live invite already" drives the admin button's state.
  @@index([schoolId, studentId])
}

/**
 * A parent asking the school for access to their own child, from the public sign-up form.
 *
 * The other direction to GuardianInvite: that one starts with an admin picking a student,
 * this one starts with a parent who found the site on their own. It exists as a stored row
 * rather than an immediate yes/no because most requests cannot be settled automatically —
 * the roster usually holds no contact for the child at all (a guardian phone only became
 * required for newly created students), so somebody at the school has to recognise the
 * family. Approving one also writes the contact onto the Student record, which is how the
 * empty column gets filled without anyone chasing a thousand numbers.
 *
 * `matched` records whether the contact the parent typed already equalled what the school
 * holds for that student. A matched EMAIL is delivered without a human, because sending to
 * an address already on file proves the requester can read that mailbox. A matched PHONE
 * cannot be: nothing here can send a WhatsApp message, so it waits for an admin to tap send
 * from their own phone. That is the whole reason this table has states rather than being a
 * fire-and-forget lookup.
 */
model GuardianAccessRequest {
  id          String   @id @default(uuid())
  schoolId    String
  // Set when the typed name and class resolved to exactly one active student. Null when
  // nothing matched, or when two children share the name, which is a case for a human.
  studentId   String?
  // What the parent typed, kept verbatim even after studentId resolves, so an admin reading
  // the queue sees the request as it was made.
  studentName String
  classLevel  String
  parentName  String?
  // Exactly one of these is set, whichever kind of contact was typed.
  email       String?
  phone       String?
  matched     Boolean  @default(false)
  status      GuardianRequestStatus @default(PENDING)
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  // Null on a request that was delivered automatically, which is what distinguishes it from
  // one an admin approved.
  resolvedBy  String?
  school      School   @relation(fields: [schoolId], references: [id])
  student     Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // The queue read: this school's outstanding requests, newest first.
  @@index([schoolId, status])
}

enum GuardianRequestStatus {
  PENDING
  SENT
  REJECTED
}

/**
 * What a FeePayment was collected for.
 *
 * TUITION is the class fee. REGISTRATION is the yearly enrolment fee, kept as its own kind
 * rather than a note on the row because the whole point is being able to total the two
 * separately and have the figures be trustworthy.
 */
enum FeeKind {
  TUITION
  REGISTRATION
}
