// SQLite variant of the schema, for the offline/local-install build.
// Mirrors prisma/schema.prisma (the Postgres/cloud schema) field-for-field,
// with ONE intentional difference: School.coverImages is Json here instead
// of String[] — SQLite doesn't support scalar list columns. Keep both
// schemas in sync by hand when adding/changing fields; see
// DEPLOYMENT_ARCHITECTURE.md for why two schemas exist.

generator client {
  provider = "prisma-client-js"
  output   = "../../generated/sqlite-client"
}

datasource db {
  provider = "sqlite"
}

enum SchoolType {
  PRIMARY
  SECONDARY
  UNIVERSITY
}

enum UserRole {
  SUPERADMIN
  SCHOOL_ADMIN
  VICE_PRINCIPAL
  CLASS_MASTER
  CLASS_TEACHER
  SUBJECT_TEACHER
  STUDENT
  PARENT
}

enum ReportStatus {
  DRAFT
  PUBLISHED
}

enum StudentStatus {
  ACTIVE
  DISABLED
  DISMISSED
}

enum MarksEntryMode {
  TEACHERS
  ADMIN_ONLY
}

/// Day or Evening sitting of the school. See the Postgres schema for the full rationale:
/// a university runs the same programme twice with the same lecturers and different
/// students, each sitting being its own ClassLevel.
enum Programme {
  DAY
  EVENING
}

model ParentSchool {
  id        String   @id @default(uuid())
  name      String
  city      String?
  country   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  sections  School[]
}

model School {
  id             String     @id @default(uuid())
  parentSchoolId String?
  name           String
  type           SchoolType
  language       String     @default("EN")
  email          String     @unique
  phone          String?
  address        String?
  website        String?
  logo           String?
  // Defaults to TEACHERS, so existing schools keep behaving exactly as they did.
  marksEntryMode MarksEntryMode @default(TEACHERS)
  marksEntryChanges MarksEntryModeChange[]
  // Official stamp/seal image. Prints on OFFICIAL copies only, via a `stamp` section
  // the admin places on the report card or transcript. Separate from `logo`: the logo
  // is the letterhead mark on every copy, the stamp is what makes a copy official.
  stamp          String?
  coverImage     String?
  coverImages    Json       @default("[]") // String[] on Postgres — SQLite has no scalar-list column type
  subdomain      String     @unique
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  acronym        String?
  batch          Int?
  repeatThreshold Float?
  // Length of one school period in minutes. Teaching hours are counted in real clock
  // hours, but a teacher's ATTENDANCE is counted in these periods, so a 100-minute class
  // on a 50-minute grid is 2 periods missed. Mirrors the Postgres schema.
  periodMinutes  Int?
  // Minutes after a period STARTS before the teacher counts as having missed it; once up,
  // that period's absence is final for everyone. null keeps the older end-of-period rule.
  // Mirrors the Postgres schema — see the fuller comment there.
  absenceGraceMinutes Int?
  authorizationNumber String?
  // Official-header letterhead text (left/right blocks in the "Official"
  // report-card header style). One EN and one FR variant per side; the
  // header auto-picks the one matching `language`.
  officialLeftTextEn  String?
  officialLeftTextFr  String?
  officialRightTextEn String?
  officialRightTextFr String?

  parentSchool   ParentSchool? @relation(fields: [parentSchoolId], references: [id])

  users                    User[]
  students                 Student[]
  subjects                 Subject[]
  terms                    Term[]
  reportCards              ReportCard[]
  classLevels              ClassLevel[]
  departments              Department[]
  reportCardTemplate       ReportCardTemplate?
  classListTemplate        ClassListTemplate?
  gradingScale             GradingScale?
  feePayments              FeePayment[]
  hndRegistrationPayments  HndRegistrationPayment[]
  excelTemplates           ExcelTemplate[]
  timetableSlots           TimetableSlot[]
  timetablePeriods         TimetablePeriod[]
  teacherAbsences          TeacherAbsence[]
  notifications            Notification[]
  pastTermMarksGrants      PastTermMarksGrant[]
  holidays                 SchoolHoliday[]
}

model GradingScale {
  id        String   @id @default(uuid())
  schoolId  String   @unique
  ranges    Json     @default("[]")
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])
}

model ReportCardTemplate {
  id        String   @id @default(uuid())
  schoolId  String   @unique
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])
}

model ClassListTemplate {
  id        String   @id @default(uuid())
  schoolId  String   @unique
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])
}

model Department {
  id        String       @id @default(uuid())
  schoolId  String
  name      String
  order     Int          @default(0)
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())

  school  School       @relation(fields: [schoolId], references: [id])
  classes ClassLevel[]

  @@unique([schoolId, name])
}

model ClassLevel {
  id                 String   @id @default(uuid())
  schoolId           String
  name               String
  abbreviation       String?
  hasStream          Boolean  @default(false)
  order              Int      @default(0)
  maxScore           Int      @default(20)
  feeAmount          Int      @default(0) // total fee for this class per academic session, in XAF
  hndRegistrationFee Int?
  departmentId       String?
  // Day or Evening sitting; existing classes are all DAY.
  programme          Programme @default(DAY)
  createdAt          DateTime @default(now())

  school     School      @relation(fields: [schoolId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@unique([schoolId, name])
}

model User {
  id                String   @id @default(uuid())
  schoolId          String?
  name              String
  email             String   @unique
  password          String
  role              UserRole
  masterClassLevel  String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  preferredLanguage String   @default("EN")
  // Departments (secondary) / programmes (university) this teacher is explicitly
  // placed in — independent of subject assignment. String[] on Postgres — SQLite
  // has no scalar-list column type.
  departments       Json     @default("[]")
  // Mirrors schema.prisma — see the comments there. getTeachers (shared code)
  // reads both, even though offline always has createdForTerm relevant only for
  // university term-scoping and passwordSetAt always non-null (set at creation).
  createdForTerm    String?
  passwordSetAt     DateTime?
  // Forgot-password flow: a single-use token hash and its expiry. Mirrors the Postgres
  // schema — without these the reset endpoints fail on an offline install.
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?

  school          School?          @relation(fields: [schoolId], references: [id])
  reportCards     ReportCard[]
  teacherSubjects TeacherSubject[]
  timetableSlots  TimetableSlot[]
  absences         TeacherAbsence[] @relation("TeacherAbsences")
  absencesRecorded TeacherAbsence[] @relation("AbsencesRecorded")
  notifications    Notification[]
  pastTermMarksGrantsGiven PastTermMarksGrant[]
}

model Student {
  id            String   @id @default(uuid())
  schoolId      String
  name          String
  gender        String?  // 'Male' | 'Female'
  studentId     String
  classLevel    String
  guardianName  String?
  guardianPhone String?
  guardianEmail String?
  // isActive stays the single source of truth every existing "active students
  // only" query already filters on — status is a richer label layered on
  // top, kept in sync by setStudentStatus, not a replacement.
  isActive          Boolean       @default(true)
  directLevel2Entry Boolean       @default(false)
  isRepeatingLevel  Boolean       @default(false)
  status            StudentStatus @default(ACTIVE)
  // Birth details. Optional everywhere. Stored as "YYYY-MM-DD" TEXT rather than a
  // DateTime on purpose — a birth date is a calendar date with no time or zone, and
  // round-tripping it through a timestamp shifts it by a day for anyone west of UTC.
  dateOfBirth       String?
  placeOfBirth      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  school                   School                   @relation(fields: [schoolId], references: [id])
  reportCards              ReportCard[]
  feePayments              FeePayment[]
  hndRegistrationPayments  HndRegistrationPayment[]

  @@unique([schoolId, studentId])
}

model FeePayment {
  id         String   @id @default(uuid())
  schoolId   String
  studentId  String
  session    String   // academic session this payment counts toward, e.g. "2026/2027"
  amount     Int      // installment amount paid, in XAF
  paidOn     DateTime // date the payment was made
  note       String?
  recordedBy String?  // id of the user who recorded the payment
  createdAt  DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, session])
}

model HndRegistrationPayment {
  id         String   @id @default(uuid())
  schoolId   String
  studentId  String
  session    String
  amount     Int
  paidOn     DateTime
  note       String?
  recordedBy String?
  createdAt  DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, session])
}

model ExcelTemplate {
  id          String   @id @default(uuid())
  schoolId    String
  name        String
  fileData    Bytes
  classLevels Json     @default("[]") // String[] on Postgres — SQLite has no scalar-list column type
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])
}

model Subject {
  id          String   @id @default(uuid())
  schoolId    String
  name        String
  code        String?
  classLevel  String
  maxScore    Int      @default(20)
  coefficient Int      @default(1)
  credit      Int?     // credit hours (university GPA courses)
  compulsory  Boolean  @default(true) // optional subjects: a student may not take them
  // Which Term this course belongs to, matched by NAME (not a Term id) — same
  // pattern as classLevel matching ClassLevel.name, so a course tagged "First
  // Semester" recurs every academic session without being recreated. Null means
  // the subject applies to every term of the class (primary/secondary today).
  term        String?
  // Target teaching hours for this subject/course row — per semester for university,
  // per academic year for primary/secondary. Null means no target set. Mirrors
  // schema.prisma — see the comment there.
  requiredHours Int?
  createdAt   DateTime @default(now())

  school          School           @relation(fields: [schoolId], references: [id])
  reportEntries   ReportEntry[]
  teacherSubjects TeacherSubject[]
  timetableSlots  TimetableSlot[]
  pastTermGrants  PastTermMarksGrant[]
}

// Mirrors schema.prisma — see the comment there.
model TimetableSlot {
  id           String    @id @default(uuid())
  schoolId     String
  teacherId    String
  dayOfWeek    String
  startTime    String
  endTime      String
  subjectId    String?
  subject      Subject?  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  label        String?
  room         String?
  specificDate String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  school       School    @relation(fields: [schoolId], references: [id])
  teacher      User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  absences     TeacherAbsence[]

  @@index([schoolId, teacherId])
  @@index([schoolId, teacherId, archivedAt])
}

// Mirrors schema.prisma — see the comment there.
model TeacherAbsence {
  id              String   @id @default(uuid())
  schoolId        String
  teacherId       String
  timetableSlotId String
  date            String
  // Which period WITHIN the slot this row is, 0-based, so a double period books two rows
  // and a late arrival loses only the period actually missed. null = a legacy whole-slot
  // row. Mirrors the Postgres schema.
  periodIndex     Int?
  recordedById    String
  // Once an admin has viewed this in the per-teacher list on a PRIOR visit it becomes a
  // locked historical record. Mirrors the Postgres schema.
  seenByAdmin     Boolean  @default(false)
  createdAt       DateTime @default(now())
  school          School         @relation(fields: [schoolId], references: [id])
  teacher         User           @relation("TeacherAbsences", fields: [teacherId], references: [id], onDelete: Cascade)
  slot            TimetableSlot  @relation(fields: [timetableSlotId], references: [id], onDelete: Cascade)
  recordedBy      User           @relation("AbsencesRecorded", fields: [recordedById], references: [id])

  @@unique([teacherId, timetableSlotId, date, periodIndex])
  @@index([schoolId, teacherId])
}

// Mirrors schema.prisma — see the comment there.
model Notification {
  id          String    @id @default(uuid())
  schoolId    String
  recipientId String
  type        String
  title       String
  body        String
  data        Json?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  school      School    @relation(fields: [schoolId], references: [id])
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
}

// Mirrors schema.prisma — see the comment there.
model TimetablePeriod {
  id        String  @id @default(uuid())
  schoolId  String
  startTime String
  endTime   String
  isBreak   Boolean @default(false)
  school    School  @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

model TeacherSubject {
  id        String   @id @default(uuid())
  userId    String
  subjectId String
  createdAt DateTime @default(now())
  // When this teacher actually took the course, and when they gave it up. Hours are only
  // counted inside this window, so a mid-term handover splits the course's hours between
  // the two teachers at the exact date the admin recorded.
  //
  // endedAt null = they still hold it. An ENDED row is deliberately kept rather than deleted:
  // it is the only record that the previous teacher ever taught it, and deleting it would
  // erase the hours they are owed.
  startedAt DateTime @default(now())
  endedAt   DateTime?
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // NOT unique on (userId, subjectId) any more: a teacher can hold a course, hand it over,
  // and take it back later, which is two legitimate rows. "Only one ACTIVE assignment per
  // teacher+course" is enforced in code instead (see assignSubjects), because a partial
  // unique index on endedAt IS NULL cannot be expressed in the Prisma schema and would show
  // as permanent drift.
  @@index([userId, subjectId])
  @@index([subjectId, endedAt])
}

// A school closure — public holiday, mid-term break, anything that cancels teaching. Stored
// as a NAMED RANGE rather than one row per day, because schools close for stretches and a
// row per day would be tedious to enter and easy to get half-wrong.
//
// Ranges are INCLUSIVE of both ends and may overlap each other; the hours maths merges them
// before subtracting, so an overlap can never remove the same day twice. Any scheduled period
// falling inside one is not counted as taught, and an absence reported for such a period stops
// subtracting too — nobody missed a class that never happened.
model SchoolHoliday {
  id        String   @id @default(uuid())
  schoolId  String
  name      String
  // Which sitting is closed. NULL = the whole school, which is what every existing holiday
  // means and stays the default. Set it only when one sitting runs through a closure the
  // other observes. Evening currently exists for universities only, so this is a no-op
  // everywhere else.
  programme Programme?
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, startDate])
}

model Term {
  id              String   @id @default(uuid())
  schoolId        String
  name            String
  session         String
  startDate       DateTime
  endDate         DateTime
  isCurrent       Boolean  @default(false)
  printingEnabled Boolean  @default(true)
  createdAt       DateTime @default(now())

  school      School       @relation(fields: [schoolId], references: [id])
  reportCards ReportCard[]
  pastTermMarksGrants PastTermMarksGrant[]
}

// Mirrors schema.prisma — see the comment there.
model PastTermMarksGrant {
  id          String   @id @default(uuid())
  schoolId    String
  subjectId   String
  termId      String
  createdAt   DateTime @default(now())
  grantedById String
  school      School   @relation(fields: [schoolId], references: [id])
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term        Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  grantedBy   User     @relation(fields: [grantedById], references: [id])

  @@unique([subjectId, termId])
  @@index([schoolId, termId])
}

model ReportCard {
  id          String       @id @default(uuid())
  studentId   String
  schoolId    String
  termId      String
  createdById String
  status              ReportStatus @default(DRAFT)
  totalScore          Float?
  average             Float?
  position            Int?
  remarks              String?
  remarksFr            String?
  remarksAiEn          String?
  remarksAiFr          String?
  remarksSource        String?
  marksEditGrantedTo   String?
  remarksEditGrantedTo String?
  decision             String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  student   Student       @relation(fields: [studentId], references: [id])
  school    School        @relation(fields: [schoolId], references: [id])
  term      Term          @relation(fields: [termId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])
  entries   ReportEntry[]

  @@unique([studentId, termId])
}

model ReportEntry {
  id           String  @id @default(uuid())
  reportCardId String
  subjectId    String
  seq1Score    Float?
  seq2Score    Float?
  // university only: exam mark re-obtained after resitting a failed course;
  // seq2Score is kept as the original attempt
  resitScore   Float?
  score        Float?
  grade        String?
  remarks      String?

  reportCard ReportCard @relation(fields: [reportCardId], references: [id])
  subject    Subject    @relation(fields: [subjectId], references: [id])
}

/// Every switch of who records marks, kept forever. Mirrors the Postgres model
/// (see prisma/schema.prisma for the full design rationale).
model MarksEntryModeChange {
  id            String         @id @default(uuid())
  schoolId      String
  mode          MarksEntryMode
  changedById   String?
  changedByName String
  changedAt     DateTime       @default(now())
  termId        String?
  byProvider    Boolean        @default(false)
  school        School         @relation(fields: [schoolId], references: [id])

  @@index([schoolId, changedAt])
  @@index([schoolId, termId])
}
